<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>SparkBar</string>
	<key>CFBundleExecutable</key>
	<string>SparkBar</string>
	<key>CFBundleIdentifier</key>
	<string>com.sparkbar.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SparkBar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>SparkBarRepositoryURL</key>
	<string>https://github.com/sambitcreate/sparkbar-mac-dgx</string>
	<!-- Add SparkDashRepositoryURL only after verifying the public repository URL. -->
	<key>SparkBarUpdatesEnabled</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://github.com/sambitcreate/sparkbar-mac-dgx/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>6fCZ3eLq9F8oYsR1umHaiq6T4kaKRohiu+zl1yrg7Vk=</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SparkBar looks for sparkDash on your local network so you can connect without typing an IP.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sparkdash._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- SparkBar talks to a user-supplied sparkDash URL, which is normally a
		     LAN address or a Tailscale host. NSAllowsLocalNetworking does not
		     cover this: it exempts unqualified names, *.local, and RFC 1918 /
		     RFC 4193 addresses, but not the Tailscale CGNAT range (100.64/10)
		     or a *.ts.net hostname, which are this app's headline deployment.
		     Switching therefore needs verification against a real tailnet.
		     The endpoint is chosen by the user, the client is GET-only, and the
		     UI requires confirmation before connecting to a public host over
		     plain HTTP (SparkDashEndpoint.shouldWarnAboutInsecureRemote). -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
